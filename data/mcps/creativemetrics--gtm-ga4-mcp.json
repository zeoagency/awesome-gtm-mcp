{
  "repo": "CreativeMetrics/gtm-ga4-mcp",
  "url": "https://github.com/CreativeMetrics/gtm-ga4-mcp",
  "commit": "2f274468eaf7dcf3fbb9d29e1d997a83bd88b302",
  "checkedAt": "2026-10-13",
  "decision": "keep",
  "reason": "Substantial real GTM v2 handlers, but OAuth uses an out-of-band redirect and container duplication has incomplete folder/reference remapping; comparison promises exceed implemented behavior.",
  "method": "source",
  "server": "index.js (stdio)",
  "exposure": "All 47 registered tools are listed unconditionally; every non-auth call, including scan_url and local Looker URL generation, loads local Google OAuth credentials.",
  "sources": [
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/index.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/gtm.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/ga4.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/search-console.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/auth.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/gtm-duplicate.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/gtm-from-scan.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/gtm-health.js",
    "https://github.com/CreativeMetrics/gtm-ga4-mcp/blob/2f274468eaf7dcf3fbb9d29e1d997a83bd88b302/src/tag-detector.js"
  ],
  "limitations": [
    "Static extraction of exact literal registration; no dependencies loaded and no authenticated or browser operations executed.",
    "OAuth uses urn:ietf:wg:oauth:2.0:oob; current OAuth login compatibility was not verified.",
    "gtm_duplicate_container cleanEntity strips parentFolderId before folder remapping and variable name references are not rewritten for prefix/suffix.",
    "compare_url_with_container does not compute the advertised missing-tag classifications.",
    "gsc_search_analytics advertises filters but its schema/dispatch does not expose or forward dimensionFilterGroups.",
    "List handlers generally do not paginate; template installation depends on current GitHub main/template.tpl URLs, and Looker template IDs were not verified.",
    "Source descriptions mention defaults/bounds, but literal schemas often omit default/minimum/maximum; preserved exactly."
  ],
